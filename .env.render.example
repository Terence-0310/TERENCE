# ============================================
# TERENCE — Render Free env template
# ============================================
# Used two ways:
#   1. Reference for the Render dashboard (Environment tab) — see docs/RENDER_VARIABLES.md.
#   2. Local pre-deploy checks: cp .env.render.example .env.render (git-ignored), fill in,
#      then `node scripts/predeploy-check.mjs`.
# Placeholders only. Never commit real values.

# ── Public URLs (replace <service> with your Render service name) ──
NEXT_PUBLIC_SITE_URL=https://<service>.onrender.com
NEXTAUTH_URL=https://<service>.onrender.com
APP_URL=https://<service>.onrender.com
ALLOWED_ORIGINS=https://<service>.onrender.com

# ── Secrets (≥32 chars; openssl rand -hex 32) — Render can generate these ──
NEXTAUTH_SECRET=
CRON_SECRET=
# Optional wallet-metadata encryption key (defaults to NEXTAUTH_SECRET). Before
# rotating NEXTAUTH_SECRET, set this to the current NEXTAUTH_SECRET value.
DATA_ENCRYPTION_KEY=

# ── Uploads are buffered in memory: keep video uploads small on 512 MB ──
MAX_VIDEO_UPLOAD_MB=40

# ── Neon PostgreSQL ──
# Pooled endpoint (host contains -pooler) for the app; keep a small Prisma pool.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require&connection_limit=5&pool_timeout=20
# Direct endpoint (no -pooler) for prisma migrate.
DIRECT_URL=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ── Upstash Redis (TCP + TLS) ──
REDIS_URL=rediss://default:<password>@<name>.upstash.io:6379

# ── Neon Object Storage (uploads) — `neon deploy` / `neon env pull` writes the AWS_* values ──
UPLOADS_BUCKET=uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://<branch-id>.storage.<region>.aws.neon.tech
AWS_REGION=ap-southeast-1
# Optional: CDN in front of the bucket (otherwise ${AWS_ENDPOINT_URL_S3}/${UPLOADS_BUCKET})
UPLOADS_PUBLIC_BASE_URL=

# ── Elasticsearch — Elastic Cloud (optional; empty host → PostgreSQL search fallback) ──
# Serverless project → Endpoints → Elasticsearch URL; API key from "Manage API keys".
ELASTICSEARCH_HOST=https://<project>.es.<region>.aws.elastic.cloud:443
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX_MOVIES=terence_movies

# ── LiveKit Cloud ──
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://<project>.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=wss://<project>.livekit.cloud

# ── Build-time public flags ──
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
NEXT_PUBLIC_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
NEXT_PUBLIC_REGION=VN

# ── Optional ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=TERENCE
EMAIL_FROM_ADDRESS=
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=
TMDB_BASE_URL=https://api.themoviedb.org/3
KKPHIM_BASE_URL=https://phimapi.com
OPHIM_BASE_URL=https://ophim1.com
DISABLE_OPHIM_CHECK=true
SEPAY_WEBHOOK_API_KEY=
SEPAY_API_KEY=
SEPAY_BANK_CODE=
SEPAY_BANK_ACCOUNT=
VIETQR_ACCOUNT_NAME=
GEMINI_API_KEY=
GNEWS_API_KEY=
YOUTUBE_API_KEY=
