datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Enums ──────────────────────────────────────────────────────
// Prisma enums for type safety in new code. Existing String fields
// are kept for backward compatibility with current data (lowercase
// values). Use these enums for validation and documentation.
// Migration from String→enum requires data normalization first.

/// Content type of a Movie entry
enum ContentType {
  MOVIE
  SERIES
  ANIME // existing data compatibility
  TRAILER // existing data compatibility
  SHORT // existing data compatibility
}

/// Role of a person in a movie production
enum PersonRole {
  ACTOR
  DIRECTOR
  PRODUCER
  WRITER
  CREATOR // existing data compatibility
  OTHER
}

/// Origin source for movie metadata
enum SourceType {
  TMDB
  IMDB
  OPHIM
  KKPHIM // existing data compatibility
  MANUAL
  INTERNAL
}

/// Status of a sync pipeline job
enum SyncJobStatus {
  PENDING
  RUNNING
  SUCCESS
  COMPLETED // existing data uses "completed"
  FAILED
  CANCELLED // existing data uses "cancelled"
  PARTIAL
}

/// Severity level for sync log entries
enum SyncLogLevel {
  INFO
  WARN
  ERROR
}

/// Playback video source type
enum VideoSourceType {
  HLS
  MP4
}

// ─── Users & Auth ───────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          String    @default("user") // super_admin | admin | staff | editor | user
  avatar        String?
  isActive      Boolean   @default(true)
  status        String    @default("active") // active | suspended | banned
  blockedReason String?
  lastLoginAt   DateTime?
  lastLoginIp   String?
  loginCount    Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  sessions               Session[]
  adminLogs              AdminLog[]
  watchHistories         WatchHistory[]
  hostedWatchParties     WatchPartyRoom[]
  watchPartyParticipants WatchPartyParticipant[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Movies ─────────────────────────────────────────────────────

model Movie {
  id               String    @id @default(cuid())
  ophimId          String?   @unique // OPhim sync ID
  tmdbId           Int? // TMDB ID
  imdbId           String? // IMDb ID (e.g. tt1234567)
  slug             String    @unique
  title            String
  originalTitle    String?
  description      String?
  shortDescription String?
  contentType      String    @default("movie") // → ContentType enum: movie | series | anime | trailer | short
  status           String    @default("draft") // draft | published | hidden | archived
  quality          String? // CAM | HD | FHD | 4K
  language         String?
  year             Int? // release year
  duration         Int? // minutes
  episodeCurrent   String? // e.g. "12/24" or "Full"
  episodeTotal     Int? // total number of episodes
  trailerUrl       String?
  trailerSite      String? // YouTube | Vimeo
  trailerKey       String? // video key for embed
  thumbUrl         String? // thumbnail
  posterUrl        String?
  backdropUrl      String?
  rating           Float?    @default(0)
  ageRating        String? // P | C13 | C16 | C18
  actorText        String? // comma-separated actor names
  directorText     String? // comma-separated director names
  countryText      String? // comma-separated country names
  categoryText     String? // comma-separated category/genre names
  tags             String? // comma-separated tags
  seoTitle         String?
  seoDescription   String?
  seoKeywords      String?
  isCopyright      Boolean   @default(false)
  isActive         Boolean   @default(true)
  isFeatured       Boolean   @default(false)
  isTrending       Boolean   @default(false)
  isRecommended    Boolean   @default(false)
  isPublished      Boolean   @default(false)
  metadataSource   String? // → SourceType enum: ophim | tmdb | manual
  matchConfidence  Float? // 0-1 confidence score for TMDB match
  sourceStatus     String    @default("pending") // active | missing | broken | pending
  viewCount        Int       @default(0)
  publishedAt      DateTime?
  lastSyncedAt     DateTime?
  createdBy        String?
  updatedBy        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  episodes       Episode[]
  shorts         Short[]
  categories     MovieCategory[]
  countries      MovieCountry[]
  people         MoviePerson[]
  movieSources   MovieSource[]
  syncJobs       SyncJob[] // ← NEW: direct relation to sync jobs
  syncLogs       SyncLog[]
  watchHistories WatchHistory[]
  watchPartyRooms WatchPartyRoom[]

  @@index([title])
  @@index([originalTitle])
  @@index([year])
  @@index([tmdbId])
  @@index([imdbId])
  @@index([isActive])
  @@index([contentType])
  @@index([status])
  @@index([isPublished])
  @@index([isFeatured])
  @@index([lastSyncedAt])
}

// ─── Episodes ───────────────────────────────────────────────────

model Episode {
  id              String   @id @default(cuid())
  movieId         String
  sourceName      String? // e.g. "OPhim", "Fshare", "Manual"
  serverName      String? // e.g. "Server #1", "Server Vietsub"
  episodeName     String? // display name: "Tập 1", "Tập Full"
  episodeSlug     String? // e.g. "tap-1"
  episodeNumber   Int      @default(1) // spec: episodeNo — kept existing name
  episodeOrder    Int      @default(0) // sort order independent of episode number
  title           String? // episode title
  slug            String? // legacy slug
  streamType      String   @default("mp4") // iframe | mp4 | hls | youtube | dash
  streamUrl       String? // primary stream URL (fallback when no VideoSource exists)
  sourceUrl       String? // legacy source URL
  backupSourceUrl String?
  subtitleUrl     String?
  duration        Int? // seconds (spec: durationSeconds)
  quality         String?
  language        String?
  sortOrder       Int      @default(0)
  status          String   @default("active") // active | broken | hidden | pending
  isActive        Boolean  @default(true)
  isPublished     Boolean  @default(true)
  description     String?
  thumbnailUrl    String?
  viewCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  movie          Movie           @relation(fields: [movieId], references: [id], onDelete: Cascade)
  watchHistories WatchHistory[]
  videoSources   VideoSource[]
  subtitleTracks SubtitleTrack[]
  watchPartyRooms WatchPartyRoom[]

  @@unique([movieId, episodeNumber]) // no duplicate ep number per movie
  @@unique([movieId, slug]) // no duplicate slug per movie
  @@index([movieId])
  @@index([episodeSlug])
  @@index([slug])
  @@index([isActive])
}

// ─── Video Sources (multi-source per episode) ───────────────────

model VideoSource {
  id         String   @id @default(cuid())
  episodeId  String
  sourceType String   @default("hls") // → VideoSourceType enum: hls | mp4
  url        String // stream URL (.m3u8 or .mp4)
  label      String   @default("Main") // e.g. "1080p", "Main", "Backup"
  mimeType   String? // e.g. "application/x-mpegURL"
  isPrimary  Boolean  @default(false)
  isActive   Boolean  @default(true)
  drmType    String? // future: widevine | fairplay | none
  priority   Int      @default(0) // higher = preferred
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([episodeId])
  @@index([sourceType])
  @@index([isPrimary, isActive]) // composite: resolving primary active source
  @@index([isActive])
}

// ─── Subtitle Tracks (VTT per episode) ──────────────────────────

model SubtitleTrack {
  id        String   @id @default(cuid())
  episodeId String
  label     String // "Vietnamese", "English"
  lang      String // "vi", "en"
  url       String // URL to .vtt file
  isDefault Boolean  @default(false)
  kind      String   @default("subtitles") // subtitles | captions
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([episodeId])
  @@index([lang])
  @@index([isDefault, isActive]) // composite: find default active subtitle
  @@index([isActive])
}

// ─── Categories (Genres) ────────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  tmdbId      Int?     @unique // TMDB genre ID for mapping
  description String? // ← NEW: category description
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  movies MovieCategory[]

  @@index([slug])
  @@index([isActive])
}

model MovieCategory {
  id         String   @id @default(cuid())
  movieId    String
  categoryId String
  createdAt  DateTime @default(now())

  movie    Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([movieId, categoryId])
  @@index([movieId])
  @@index([categoryId])
}

// ─── Countries ──────────────────────────────────────────────────

model Country {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  code      String?  @unique // ISO 3166-1 alpha-2 (US, VN, KR, ...)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movies MovieCountry[]

  @@index([slug])
  @@index([code])
  @@index([isActive])
}

model MovieCountry {
  id        String   @id @default(cuid())
  movieId   String
  countryId String
  createdAt DateTime @default(now())

  movie   Movie   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([movieId, countryId])
  @@index([movieId])
  @@index([countryId])
}

// ─── People (Actors, Directors, etc.) ───────────────────────────

model Person {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  originalName String? // ← NEW: original/native name
  tmdbId       Int?      @unique // spec: tmdbPersonId — kept existing name
  imdbId       String? // spec: imdbPersonId — kept existing name
  profileUrl   String? // photo URL (spec: avatarUrl — kept existing name)
  biography    String?
  birthDate    DateTime? // spec: birthday — kept existing name
  deathDate    DateTime? // spec: deathday — kept existing name
  gender       Int? // 0: not specified, 1: female, 2: male, 3: non-binary
  knownFor     String? // Acting | Directing | Writing | Production
  popularity   Float?    @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  movies MoviePerson[]

  @@index([name])
  @@index([slug])
  @@index([tmdbId])
  @@index([isActive])
}

model MoviePerson {
  id         String   @id @default(cuid())
  movieId    String
  personId   String
  role       String   @default("actor") // → PersonRole enum: actor | director | writer | producer | creator
  character  String? // character name for actors (spec: characterName)
  department String? // ← NEW: e.g. "Acting", "Directing", "Production"
  job        String? // ← NEW: e.g. "Director", "Executive Producer"
  sortOrder  Int      @default(0) // spec: castOrder — kept existing name
  isActive   Boolean  @default(true) // ← NEW: soft-delete support
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt // ← NEW: track edits

  movie  Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([movieId, personId, role])
  @@index([movieId])
  @@index([personId])
  @@index([role])
  @@index([sortOrder])
}

// ─── Movie Sources (multi-source tracking) ──────────────────────

model MovieSource {
  id            String    @id @default(cuid())
  movieId       String
  sourceName    String // → SourceType enum: OPhim | KKPhim | Fshare | Manual | TMDB
  sourceUrl     String? // external URL or reference (spec: sourceUrl)
  sourceId      String? // ID on external source (spec: externalId)
  quality       String? // HD | FHD | 4K
  language      String? // vietsub | thuyetminh | engsub | raw
  priority      Int       @default(0) // higher = preferred
  isPrimary     Boolean   @default(false) // ← NEW: mark primary source
  isActive      Boolean   @default(true)
  confidence    Float? // ← NEW: match confidence 0-1
  notes         String? // ← NEW: admin notes
  metadata      String? // JSON string for extra data (spec: rawPayload)
  lastChecked   DateTime? // spec: lastFetchedAt — kept existing name
  lastSuccessAt DateTime? // ← NEW: last successful fetch
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([movieId, sourceName, sourceId]) // ← NEW: prevent duplicate source entries
  @@index([movieId])
  @@index([sourceName])
  @@index([isActive])
  @@index([isPrimary, isActive]) // ← NEW: composite for primary source lookup
}

// ─── Sync Jobs ──────────────────────────────────────────────────

model SyncJob {
  id             String    @id @default(cuid())
  movieId        String? // ← NEW: optional link to specific movie
  source         String // → SourceType enum: ophim | tmdb | kkphim
  jobType        String // full | incremental | single
  status         String    @default("pending") // → SyncJobStatus enum: pending | running | completed | failed | cancelled
  totalItems     Int       @default(0)
  processedItems Int       @default(0)
  successItems   Int       @default(0) // ← NEW: count of successful items
  failedItems    Int       @default(0)
  skippedItems   Int       @default(0)
  errorMessage   String?
  metadata       String? // JSON string with extra info (spec: payload)
  startedAt      DateTime?
  completedAt    DateTime? // spec: finishedAt — kept existing name
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  movie    Movie?    @relation(fields: [movieId], references: [id], onDelete: SetNull) // ← NEW
  syncLogs SyncLog[]

  @@index([movieId]) // ← NEW
  @@index([source])
  @@index([status])
  @@index([createdAt])
}

// ─── Sync Logs ──────────────────────────────────────────────────

model SyncLog {
  id        String   @id @default(cuid())
  syncJobId String?
  movieId   String?
  source    String // → SourceType enum: ophim | tmdb | kkphim
  action    String // create | update | skip | fail | match | enrich
  status    String   @default("success") // success | warning | error
  level     String   @default("info") // ← NEW: → SyncLogLevel enum: info | warn | error
  message   String?
  context   String? // ← NEW: structured context data (JSON string)
  metadata  String? // JSON string with sync details
  createdAt DateTime @default(now())

  syncJob SyncJob? @relation(fields: [syncJobId], references: [id], onDelete: SetNull)
  movie   Movie?   @relation(fields: [movieId], references: [id], onDelete: SetNull)

  @@index([syncJobId])
  @@index([movieId])
  @@index([source])
  @@index([action])
  @@index([level]) // ← NEW
  @@index([createdAt])
}

// ─── Watch Histories ────────────────────────────────────────────

model WatchHistory {
  id            String   @id @default(cuid())
  userId        String
  movieId       String
  episodeId     String? // nullable: standalone movie progress without episode
  watchedAt     DateTime @default(now())
  lastWatchedAt DateTime @default(now())
  progress      Float    @default(0) // 0-100% (spec: percent)
  duration      Int? // total duration in seconds (spec: durationSeconds)
  currentTime   Int? // current playback position in seconds (spec: progressSeconds)
  isCompleted   Boolean  @default(false) // spec: completed — kept existing name
  deviceType    String? // mobile | desktop | tablet | tv
  ipAddress     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie   Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  episode Episode? @relation(fields: [episodeId], references: [id], onDelete: SetNull)

  @@unique([userId, movieId, episodeId])
  @@index([userId])
  @@index([userId, lastWatchedAt]) // composite: continue watching query
  @@index([movieId])
  @@index([episodeId])
  @@index([lastWatchedAt])
  @@index([isCompleted])
}

// ─── Shorts ─────────────────────────────────────────────────────

model Short {
  id           String    @id @default(cuid())
  movieId      String?
  title        String
  slug         String    @unique
  description  String?
  videoUrl     String?
  sourceType   String    @default("mp4") // mp4 | hls | youtube | iframe
  thumbnailUrl String?
  duration     Int? // seconds
  hashtags     String? // comma-separated
  status       String    @default("draft") // draft | published | hidden | archived
  viewCount    Int       @default(0)
  likeCount    Int       @default(0)
  shareCount   Int       @default(0)
  saveCount    Int       @default(0)
  createdBy    String?
  updatedBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  movie Movie? @relation(fields: [movieId], references: [id], onDelete: SetNull)
}

// ─── Admin Audit Log ────────────────────────────────────────────

model AdminLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String // login | create | update | delete | block | unblock | upload | change_role | sync
  targetType String? // movie | episode | short | user | upload | sync_job
  targetId   String?
  metadata   String? // JSON string
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)
}

// ─── Upload Tracking ────────────────────────────────────────────

model Upload {
  id           String   @id @default(cuid())
  fileName     String
  originalName String
  mimeType     String
  size         Int
  path         String
  url          String
  uploadedBy   String?
  createdAt    DateTime @default(now())
}

// ─── Page Views (minimal analytics) ─────────────────────────────

model PageView {
  id        String   @id @default(cuid())
  path      String
  movieId   String?
  shortId   String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
}

// ─── Watch Party ────────────────────────────────────────────────

/// Room status for a watch party session
enum WatchPartyStatus {
  ACTIVE
  ENDED
}

/// Role of a participant in a watch party
enum WatchPartyRole {
  HOST
  MEMBER
  GUEST
}

model WatchPartyRoom {
  id           String   @id @default(cuid())
  roomCode     String   @unique
  title        String
  hostUserId   String? // nullable: guest hosts allowed
  movieId      String? // optional: link to Movie
  episodeId    String? // optional: link to Episode
  status       String   @default("ACTIVE") // → WatchPartyStatus: ACTIVE | ENDED
  shareCode    String?  @unique // alternate invite code, nullable
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastSyncedAt DateTime?

  host         User?                  @relation(fields: [hostUserId], references: [id], onDelete: SetNull)
  movie        Movie?                 @relation(fields: [movieId], references: [id], onDelete: SetNull)
  episode      Episode?               @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  participants WatchPartyParticipant[]
  state        WatchPartyState?
  messages     WatchPartyMessage[]

  @@index([status])
  @@index([hostUserId])
  @@index([roomCode])
  @@index([createdAt])
}

model WatchPartyMessage {
  id            String   @id @default(cuid())
  roomId        String
  participantId String?  // null for system messages
  senderName    String
  type          String   @default("chat") // chat | system | reaction
  content       String
  createdAt     DateTime @default(now())

  room WatchPartyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([roomId, createdAt])
}

model WatchPartyParticipant {
  id          String    @id @default(cuid())
  roomId      String
  userId      String? // nullable: guest participants
  displayName String
  role        String    @default("MEMBER") // → WatchPartyRole: HOST | MEMBER | GUEST
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?
  isOnline    Boolean   @default(true)
  lastSeenAt  DateTime?

  room WatchPartyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([roomId])
  @@index([userId])
  @@index([roomId, isOnline])
}

model WatchPartyState {
  id            String   @id @default(cuid())
  roomId        String   @unique
  movieId       String?
  episodeId     String?
  playbackTime  Float    @default(0)
  isPlaying     Boolean  @default(false)
  playbackRate  Float    @default(1)
  lastEventType String? // PLAY | PAUSE | SEEK | CHANGE_EPISODE
  lastEventBy   String? // participant ID who triggered
  version       Int      @default(1)
  updatedAt     DateTime @updatedAt

  room WatchPartyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
}
