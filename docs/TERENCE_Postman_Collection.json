          }
        },
        {
          "name": "Get Current User (Me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('Trả về user hoặc null', () => { pm.response.to.have.status(200); });",
                  "if (res.user) {",
                  "  pm.test('User có email', () => { pm.expect(res.user.email).to.be.a('string'); });",
                  "  pm.collectionVariables.set('userId', res.user.id || '');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "Kiểm tra session hiện tại.\n\n- Đã login: trả `{ user: {...} }`\n- Chưa login: trả `{ user: null }`"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            },
            "description": "Xóa session cookie. Sau khi logout, cần login lại để test API authenticated."
          }
        }
      ]
    },
