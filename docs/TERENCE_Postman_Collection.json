    {
      "name": "3. Watch History (Cần Login)",
      "description": "Lịch sử xem phim — Yêu cầu đăng nhập trước (cookie session).",
      "item": [
        {
          "name": "Bootstrap (Khởi tạo trang xem phim)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => { pm.response.to.have.status(200); });",
                  "const res = pm.response.json();",
                  "if (res.movie) {",
                  "  pm.collectionVariables.set('movieId', res.movie.id);",
                  "  console.log('📝 Auto-set movieId=' + res.movie.id);",
                  "}",
                  "if (res.currentEpisode && res.currentEpisode.episode) {",
                  "  pm.collectionVariables.set('episodeId', res.currentEpisode.episode.id);",
                  "  console.log('📝 Auto-set episodeId=' + res.currentEpisode.episode.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/watch-history/bootstrap?movieSlug={{movieSlug}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "watch-history", "bootstrap"],
              "query": [
                { "key": "movieSlug", "value": "{{movieSlug}}" },
                { "key": "episode", "value": "tap-1", "disabled": true }
              ]
            },
            "description": "Lấy toàn bộ dữ liệu cần thiết cho trang xem phim:\n- Thông tin phim\n- Danh sách tập\n- Tập hiện tại + video sources\n- Resume progress (nếu đã login)\n\n⚡ Auto-set `movieId` và `episodeId` cho các request sau."
          }
        },
        {
          "name": "Save Progress (Lưu tiến trình)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => { pm.response.to.have.status(200); });",
                  "const res = pm.response.json();",
                  "pm.test('Có trả về progress', () => { pm.expect(res).to.have.property('ok'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
