# Build-context filter for Dockerfile.prod (BuildKit picks <Dockerfile>.dockerignore).

# ── Secrets: no env file may enter the image ──
.env
.env.*
**/.env
**/.env.*

# ── Build artifacts / deps ──
node_modules
.next
.turbo
tsconfig.tsbuildinfo
coverage/
.vitest/

# ── VCS / editors / docs ──
.git
.github
.husky
.vscode
.idea
.ai/
*.md
docs/

# ── Data / dumps / backups ──
*.db
*.db-journal
/*.sql
/*.dump
backups/
.deploy-state/
public/uploads/

# ── Not needed in the image ──
FUN/
tests/
vitest.config.ts
deploy/
deploy.sh
ecosystem.config.js
Dockerfile*
docker-compose*.yml
TERENCE_Postman_Collection.json
