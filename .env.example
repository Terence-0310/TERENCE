# ============================================
# TERENCE — Environment Variables Example
# ============================================
# Copy this file to .env and fill in your values.
# Prisma CLI reads .env (NOT .env.local)

NODE_ENV=development
PORT=3000

# ── Database (PostgreSQL) ──
# Local dev: use Docker or local PostgreSQL
# Production: use managed PostgreSQL (e.g. Supabase, Neon, Railway, VPS)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/terence_dev?schema=public"
# Direct connection URL (bypasses connection pooler if one is used)
# Leave same as DATABASE_URL if not using a pooler
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/terence_dev?schema=public"

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# TMDB API
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token_here
TMDB_BASE_URL=https://api.themoviedb.org/3

# TMDB Image
NEXT_PUBLIC_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/original

# Region
NEXT_PUBLIC_REGION=VN

# OPhim API
OPHIM_BASE_URL=https://ophim1.com
OPHIM_TIMEOUT=15000
OPHIM18_BASE_URL=https://ophim1.com
OPHIM18_TIMEOUT=20000

# Elasticsearch (optional)
ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_INDEX_MOVIES=terence_movies
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Streaming / Player
DEMO_HLS_URL=https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8
PUBLIC_STREAM_ALLOWED_HOSTS=test-streams.mux.dev,devstreaming-cdn.apple.com
NEXT_PUBLIC_ENABLE_RESUME=true
NEXT_PUBLIC_ENABLE_SUBTITLES=true

# GNews API (optional)
GNEWS_API_KEY=

# ============================================
# LiveKit — Watch Party Voice/Video Call
# ============================================
# Create a free project at https://cloud.livekit.io
# Free tier: 10 participants, 50 hours/month
#
# LIVEKIT_API_KEY and LIVEKIT_API_SECRET are SERVER-ONLY.
# They MUST NOT be exposed to the client.
# Only NEXT_PUBLIC_LIVEKIT_URL is sent to the browser.

LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-project.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# ============================================
# Production Only
# ============================================
# Uncomment HOSTNAME for production deployment:
# HOSTNAME=0.0.0.0
