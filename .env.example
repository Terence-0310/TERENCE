# ── App ──────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Database (SQLite) ────────────────────────
DATABASE_URL="file:./prisma/dev.db"

# ── Site URL (PUBLIC — embedded lúc build) ───
NEXT_PUBLIC_SITE_URL=https://terence.com.vn

