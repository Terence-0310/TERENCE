# ─────────────────────────────────────────────────────────────────
# DATABASE (PostgreSQL)
# ─────────────────────────────────────────────────────────────────
# [DEV LOCAL] Docker PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/terence_dev?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/terence_dev?schema=public"

# [PRODUCTION CLOUD] Uncomment and replace:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&pgbouncer=true"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# ─────────────────────────────────────────────────────────────────
# NEXT AUTH — MUST be changed before deploying to production
# ─────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=change_me_to_a_random_32_char_string
NEXTAUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GOOGLE OAUTH
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Cloudflare Turnstile (CAPTCHA) — public site key embedded in registration form
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# ─────────────────────────────────────────────────────────────────
# EMAIL / SMTP (Nodemailer)
# ─────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_FROM_NAME=TERENCE
EMAIL_FROM_ADDRESS=your_email@gmail.com

# ─────────────────────────────────────────────────────────────────
# PAYMENTS (VietQR + SePay)
# ─────────────────────────────────────────────────────────────────
# Primary bank config. Read by src/be/modules/payments/vietqr.ts and used to
# build both qr.sepay.vn and img.vietqr.io URLs. Change these to switch banks
# — no code changes needed (vietqr.ts reads env on every QR build).
# Examples: MBBank, VCB, TCB, ACB, VietinBank ...
SEPAY_BANK_CODE=MBBank
SEPAY_BANK_ACCOUNT=0385272094
SEPAY_PAYMENT_PREFIX=TCOIN

# Legacy aliases — kept for backward compatibility. If both SEPAY_* and
# VIETQR_* are set, SEPAY_* wins.
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=YOUR ACCOUNT NAME
VIETQR_TEMPLATE=compact2

SEPAY_API_KEY=your_sepay_api_key_here
SEPAY_WEBHOOK_SECRET=your_sepay_webhook_secret_here

# GRAPUCO
GRAPUCO_API_KEY=your_grapuco_api_key_here

# ─────────────────────────────────────────────────────────────────
# REDIS CACHE
# ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────────────────────────
# LIVEKIT (Watch Party real-time)
# ─────────────────────────────────────────────────────────────────
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit-server.livekit.cloud

# ─────────────────────────────────────────────────────────────────
# TMDB (Movie metadata)
# ─────────────────────────────────────────────────────────────────
TMDB_API_KEY=your_tmdb_api_key
TMDB_READ_ACCESS_TOKEN=your_tmdb_v4_read_access_token
TMDB_BASE_URL=https://api.themoviedb.org/3
NEXT_PUBLIC_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# ─────────────────────────────────────────────────────────────────
# ELASTICSEARCH (Search index)
# ─────────────────────────────────────────────────────────────────
ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_INDEX_MOVIES=movies
# Pick one auth method:
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=

# ─────────────────────────────────────────────────────────────────
# EXTERNAL VIDEO SOURCES (Ophim, KKPhim)
# ─────────────────────────────────────────────────────────────────
OPHIM_BASE_URL=https://ophim1.com
OPHIM_TIMEOUT=15000
KKPHIM_BASE_URL=https://phimapi.com
KKPHIM_TIMEOUT=15000
# Skip Ophim health checks in CI / when API is rate-limited
DISABLE_OPHIM_CHECK=false

# ─────────────────────────────────────────────────────────────────
# NEWS — three layered sources, in this priority:
#   1. DB NewsPost rows (admin-curated or AI-generated). Always read first.
#   2. GNews API — real entertainment news (free 100 req/day at gnews.io).
#   3. Hardcoded fallback — only when both above are empty.
#
# NewsPost rows can be populated either by:
#   - Admin writing posts at /dashboard/news/new (no API key needed).
#   - The Gemini AI generator below (requires GEMINI_API_KEY).
# ─────────────────────────────────────────────────────────────────
GNEWS_API_KEY=

# ─────────────────────────────────────────────────────────────────
# GEMINI AI (auto news generation)
# ─────────────────────────────────────────────────────────────────
# Get a free key at https://aistudio.google.com/apikey
# Free tier: 15 req/min, 1500 req/day for gemini-2.0-flash.
# Used by `POST /api/admin/news/ai-generate` to turn TMDB movies into
# Vietnamese NewsPost articles. Leave blank to disable AI generation.
GEMINI_API_KEY=
# Note: gemini-2.0-flash was removed from the free tier in May 2026.
# Use gemini-2.5-flash (recommended) or gemini-2.5-flash-lite for higher RPM.
GEMINI_MODEL=gemini-2.5-flash

# ─────────────────────────────────────────────────────────────────
# MISC
# ─────────────────────────────────────────────────────────────────
# Shared secret required by /api/cron/* endpoints (sent as Authorization: Bearer ...)
CRON_SECRET=change_me_to_a_random_string

# Display region for FE (e.g. VN, US) — affects locale-dependent UI
NEXT_PUBLIC_REGION=VN

# CORS origins for Socket.IO server (comma-separated, no spaces).
# Example: ALLOWED_ORIGINS=https://terence.com.vn,https://www.terence.com.vn,https://rtc.terence.com.vn
# Dev defaults to '*'. Leave unset in production only if you accept localhost-only.
ALLOWED_ORIGINS=

# Logger verbosity: debug | info | warn | error
LOG_LEVEL=info

# Demo HLS source used by the player when no source is configured
DEMO_HLS_URL=
