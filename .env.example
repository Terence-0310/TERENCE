# ============================================
# TERENCE — Environment Variables
# Copy this file to .env and fill in real values
# ============================================

# ── App ──────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Site URL (PUBLIC — embedded in client JS at build time) ──
NEXT_PUBLIC_SITE_URL=https://terence.com.vn

# ── TMDB API (SERVER-ONLY — never exposed to browser) ────────
# Đăng ký miễn phí: https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=
TMDB_BASE_URL=https://api.themoviedb.org/3

# ── TMDB Image (PUBLIC) ──────────────────────
NEXT_PUBLIC_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# ── Region (PUBLIC) ──────────────────────────
NEXT_PUBLIC_REGION=VN
