# ============================================
# TERENCE — Production Environment (.env)
# ============================================
# Deploy path: /var/www/TERENCE/.env
# Server: Vultr VPS
# Domains: terence.com.vn + rtc.terence.com.vn

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Database (SQLite)
DATABASE_URL="file:./prisma/dev.db"

# Site URL
NEXT_PUBLIC_SITE_URL=https://terence.com.vn

# TMDB API
TMDB_API_KEY=<your-tmdb-api-key>
TMDB_READ_ACCESS_TOKEN=<your-tmdb-read-access-token>
TMDB_BASE_URL=https://api.themoviedb.org/3

# TMDB Image
NEXT_PUBLIC_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/original

# Region
NEXT_PUBLIC_REGION=VN

# OPhim API
OPHIM_BASE_URL=https://ophim1.com
OPHIM_TIMEOUT=15000
OPHIM18_BASE_URL=https://ophim1.com
OPHIM18_TIMEOUT=20000

# Streaming / Player
DEMO_HLS_URL=https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8
PUBLIC_STREAM_ALLOWED_HOSTS=test-streams.mux.dev,devstreaming-cdn.apple.com
NEXT_PUBLIC_ENABLE_RESUME=true
NEXT_PUBLIC_ENABLE_SUBTITLES=true

# ============================================
# LiveKit — Watch Party (Production)
# ============================================
# These values connect to LiveKit Cloud.
# API key/secret are SERVER-ONLY — never exposed to client.

LIVEKIT_URL=wss://terence-dlkoc95s.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=wss://terence-dlkoc95s.livekit.cloud
LIVEKIT_API_KEY=APIkktCikvnKLRg
LIVEKIT_API_SECRET=09eEQjUEyx6umwdC0jHjyrZ3vmHfyCovvP3dDAMW2Lr
