.next/
out/

# Environment (secrets — NEVER commit these)
.env
.env.local
.env*.local
.env.production
.env.development
.env.staging
# .env.example is safe to commit (contains only placeholders)

# AI / MCP
.antigravity/

# Database (local dev)
prisma/dev.db
prisma/dev.db-journal
prisma/prisma/
*.db
*.db-journal

# Database dumps / backups (root-level only — keep prisma migration .sql files)
/*.dump
/*.sql

# TypeScript
tsconfig.tsbuildinfo

# OS
.DS_Store
Thumbs.db

# PM2 logs
/logs/

# Editor
.vscode/
*.swp
*.swo

# Temp
tmp/
*.log

# Script output files
scripts/*.txt
scripts/*.json

# Production deploy (deploy/oracle): DB backups + deployed image tags
/backups/
/.deploy-state/
.neon

# Render (real values for scripts/predeploy-check.mjs) + compiled custom server
.env.render
/dist/

# Secrets: every env variant except committed templates
.env.*
!.env.example
!.env.*.example
!deploy/oracle/env.production.example

# Keys, certificates, credential exports
*.pem
*.key
*.p12
*.pfx
id_rsa*
*.jks
credentials*.json
service-account*.json

# Database dumps / exports anywhere (migration .sql files stay tracked)
*.dump
*.sql.gz
*.bak
