{
  "info": {
    "name": "TERENCE API Collection",
    "description": "Toàn bộ API core của hệ thống TERENCE (Phim, Người dùng, TCoin, Watch Party, Admin)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication (User)",
      "item": [
        {
          "name": "Đăng ký thành viên",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Người Dùng Test\",\n    \"email\": \"test@example.com\",\n    \"password\": \"12345678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Client APIs (V1)",
      "item": [
        {
          "name": "Trang chủ (Home)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/home",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "home"]
            }
          }
        },
        {
          "name": "Bảng Xếp Hạng Xu Hướng",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/movies/trending-stats",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "movies", "trending-stats"]
            }
          }
        },
        {
          "name": "Phim Được Yêu Thích",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/movies/most-liked",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "movies", "most-liked"]
            }
          }
        },
        {
          "name": "Tìm Kiếm (Search)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/search?q=demon slayer",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "search"],
              "query": [
                { "key": "q", "value": "demon slayer" }
              ]
            }
          }
        },
        {
          "name": "Gợi Ý Autocomplete",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/search/suggest?q=batman",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "search", "suggest"],
              "query": [
                { "key": "q", "value": "batman" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Watch History & Progress",
      "item": [
        {
          "name": "Lưu Tiến Độ Xem",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"movieId\": \"12345\",\n    \"episodeId\": \"abc-123\",\n    \"progress\": 1500,\n    \"duration\": 3600,\n    \"isCompleted\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/watch-history/progress",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "watch-history", "progress"]
            }
          }
        },
        {
          "name": "Lấy Danh Sách Đang Xem",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/watch-history/continue",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "watch-history", "continue"]
            }
          }
        }
      ]
    },
    {
      "name": "4. TCoin System",
      "item": [
        {
          "name": "Lấy Ví TCoin",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tcoin/wallet",
              "host": ["{{baseUrl}}"],
              "path": ["tcoin", "wallet"]
            }
          }
        },
        {
          "name": "Điểm Danh Hàng Ngày",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/tcoin/reward/daily-checkin",
              "host": ["{{baseUrl}}"],
              "path": ["tcoin", "reward", "daily-checkin"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Watch Party",
      "item": [
        {
          "name": "Tạo Phòng Mới",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"movieId\": \"12345\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/watch-party/create",
              "host": ["{{baseUrl}}"],
              "path": ["watch-party", "create"]
            }
          }
        },
        {
          "name": "Tham Gia Phòng",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"roomCode\": \"XYZ123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/watch-party/join",
              "host": ["{{baseUrl}}"],
              "path": ["watch-party", "join"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Admin CMS",
      "item": [
        {
          "name": "Lấy Thông Kê Tổng",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/summary",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "summary"]
            }
          }
        },
        {
          "name": "Kích hoạt Đồng Bộ OPhim",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/admin/sync/ophim/catalog",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "sync", "ophim", "catalog"]
            }
          }
        }
      ]
    }
  ]
}
