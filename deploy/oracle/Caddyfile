# ============================================
# TERENCE — Caddy (HTTPS reverse proxy) for docker-compose.prod.yml
# ============================================
# Certificates are issued automatically by Let's Encrypt once DNS A records for
# APP_DOMAIN and LIVEKIT_DOMAIN point at this VM and ports 80/443 are open.
# WebSocket upgrades (Socket.IO at /api/socketio, LiveKit signalling) are
# proxied by reverse_proxy without extra configuration.
#
# Caddy replaces any client-sent X-Forwarded-For with the real peer address
# (no trusted_proxies configured). If you put Cloudflare's proxy in front of
# APP_DOMAIN, add its ranges via `trusted_proxies static ...` in the servers
# block below — otherwise rate limits see Cloudflare IPs. LIVEKIT_DOMAIN must
# stay DNS-only (grey cloud): WebRTC media cannot go through Cloudflare.
# ============================================

{
	email {$ACME_EMAIL}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		# camera/mic/screen are needed by watch-party calls on our own origin.
		Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=(), payment=()"
		-Server
	}
}

{$APP_DOMAIN} {
	import security_headers
	encode zstd gzip

	log {
		output stdout
		format json
	}

	# MAX_VIDEO_SIZE is 500 MB (src/be/modules/uploads/legacy-upload.ts) + multipart overhead.
	request_body {
		max_size 520MB
	}

	# User uploads live in the shared "uploads" volume. Next.js only serves
	# public/ files that existed at boot, so Caddy serves them directly — with a
	# locked-down CSP so an uploaded file can never run script on our origin.
	handle_path /uploads/* {
		root * /srv/uploads
		header {
			Content-Security-Policy "default-src 'none'; img-src 'self'; media-src 'self'; style-src 'unsafe-inline'; sandbox"
			Cache-Control "public, max-age=604800"
		}
		file_server
	}

	handle {
		@static path /_next/static/*
		header @static Cache-Control "public, max-age=31536000, immutable"

		# No active health check: /api/health answers 503 when only ES/Redis is
		# degraded, and the app keeps serving in that state.
		reverse_proxy app:3000
	}
}

# Optional: redirect www → apex. Uncomment only after creating the www DNS record,
# otherwise Caddy keeps retrying a certificate it cannot obtain.
# www.{$APP_DOMAIN} {
# 	redir https://{$APP_DOMAIN}{uri} permanent
# }

{$LIVEKIT_DOMAIN} {
	import security_headers
	reverse_proxy livekit:7880
}
