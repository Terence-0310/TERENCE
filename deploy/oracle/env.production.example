# ============================================
# TERENCE — production env template (docker-compose.prod.yml)
# ============================================
#   cp deploy/oracle/env.production.example .env.production
#   chmod 600 .env.production && nano .env.production
# .env.production is git-ignored and excluded from the image build context.
# Generate secrets with:  openssl rand -hex 32   (hex = no URL-encoding issues)
#
# Derived automatically by docker-compose.prod.yml — do NOT set here:
#   NEXTAUTH_URL, APP_URL, NEXT_PUBLIC_SITE_URL, ALLOWED_ORIGINS,
#   NEXT_PUBLIC_LIVEKIT_URL, LIVEKIT_URL, DATABASE_URL, DIRECT_URL, REDIS_URL,
#   ELASTICSEARCH_HOST / USERNAME / PASSWORD
# ============================================

# ── Domains / TLS (required) ──
APP_DOMAIN=terence.example.com
LIVEKIT_DOMAIN=livekit.terence.example.com
ACME_EMAIL=admin@example.com
TZ=Asia/Ho_Chi_Minh

# ── Secrets (required, ≥32 chars each) ──
NEXTAUTH_SECRET=
CRON_SECRET=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
ELASTIC_PASSWORD=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Database names (optional) ──
POSTGRES_USER=terence
POSTGRES_DB=terence

# ── Image / resource tuning (optional) ──
# APP_IMAGE_TAG is managed by deploy.sh / rollback.sh.
ES_VERSION=8.19.23
ES_JAVA_OPTS=-Xms1g -Xmx1g
LIVEKIT_VERSION=v1.13.10
ELASTICSEARCH_INDEX_MOVIES=terence_movies
LOG_LEVEL=info

# ── Build-time public flags (rebuild after changing) ──
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
NEXT_PUBLIC_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
NEXT_PUBLIC_REGION=VN

# ── Google sign-in (optional; callback: https://APP_DOMAIN/api/auth/callback/google) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email / SMTP (required for register / forgot-password mails) ──
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=TERENCE
EMAIL_FROM_ADDRESS=

# ── Movie metadata & sources ──
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=
TMDB_BASE_URL=https://api.themoviedb.org/3
OPHIM_BASE_URL=https://ophim1.com
OPHIM_TIMEOUT=15000
OPHIM18_BASE_URL=
OPHIM18_TIMEOUT=15000
KKPHIM_BASE_URL=https://phimapi.com
KKPHIM_TIMEOUT=20000
DISABLE_OPHIM_CHECK=true
YOUTUBE_API_KEY=

# ── Player ──
DEMO_HLS_URL=
PUBLIC_STREAM_ALLOWED_HOSTS=

# ── TCoin top-up: SePay webhook + VietQR (webhook: https://APP_DOMAIN/api/webhooks/...) ──
SEPAY_WEBHOOK_API_KEY=
SEPAY_API_KEY=
SEPAY_BANK_CODE=
SEPAY_BANK_ACCOUNT=
VIETQR_ACCOUNT_NAME=

# ── News / AI (optional) ──
GNEWS_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── One-off seed passwords (only used by `npm run db:seed` / seed scripts) ──
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
SEED_USER_PASSWORD=
