# ── Build artifacts ──
node_modules
.next
.turbo

# ── Version control ──
.git
.gitignore

# ── IDE / Editor ──
.vscode
.idea
*.swp
*.swo

# ── Local env (secrets stay on host) ──
# All env files: Next's standalone output would otherwise copy .env into the
# image. Runtime config comes from docker-compose env_file / environment.
.env
.env.*
!.env.example
.env*.local

# ── Keys / certificates / dumps ──
*.pem
*.key
*.p12
*.pfx
*.dump
backups/
.deploy-state/

# ── Documentation ──
*.md
docs/
.ai/

# ── Legacy SQLite ──
*.db
*.db-journal

# ── DB dumps / backups (root-level only — keep prisma migration .sql) ──
/*.sql
/*.dump

# ── Personal gift source (served copy lives in public/mychi) ──
FUN/

# ── Tests / Coverage ──
tests/
coverage/
vitest.config.ts
.vitest/

# ── OS files ──
.DS_Store
Thumbs.db

# ── Deploy scripts (not needed in image) ──
deploy/
deploy.sh
ecosystem.config.js

# ── Docker files (prevent recursive copy) ──
Dockerfile
docker-compose.yml

# ── Misc ──
tsconfig.tsbuildinfo
