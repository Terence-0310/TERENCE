{
  "name": "terence",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:socket": "npx tsx server.ts",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "start:standalone": "HOSTNAME=0.0.0.0 PORT=3000 node .next/standalone/server.js",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "npx prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "sync:ophim:catalog": "npx tsx scripts/sync-ophim-catalog.ts",
    "sync:ophim:movie": "npx tsx scripts/sync-ophim-movie.ts",
    "sync:ophim18:movie": "npx tsx scripts/sync-ophim18-movie.ts",
    "sync:ophim18:catalog": "npx tsx scripts/sync-ophim18-catalog.ts",
    "enrich:tmdb": "npx tsx scripts/enrich-tmdb.ts",
    "pipeline:movie": "npx tsx scripts/pipeline-movie.ts",
    "elastic:reindex": "npx tsx scripts/elastic-reindex.ts",
    "elastic:sync": "npx tsx scripts/elastic-reindex.ts",
    "docs:check": "node scripts/docs-check.mjs",
    "docs:update-hint": "echo '⚠️  Nhớ cập nhật README.md nếu có thay đổi chức năng/API/schema/env/route. Xem Mục 11.'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:docker": "docker compose -f docker-compose.test.yml up --build --abort-on-container-exit"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
