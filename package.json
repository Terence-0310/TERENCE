{
  "name": "terence",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:socket": "npx tsx server.ts",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "start:standalone": "HOSTNAME=0.0.0.0 PORT=3000 node .next/standalone/server.js",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.mjs",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --schema=src/dta/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema=src/dta/prisma/schema.prisma",
    "db:seed": "npx tsx --require dotenv/config src/dta/prisma/seed.ts",
    "db:reset": "prisma migrate --schema=src/dta/prisma/schema.prisma reset --force",
    "sync:ophim:catalog": "npx tsx --require dotenv/config src/dta/scripts/sync-ophim-catalog.ts",
    "sync:kkphim:catalog": "npx tsx --require dotenv/config src/dta/scripts/sync-kkphim-catalog.ts",
    "sync:kkphim:movie": "npx tsx --require dotenv/config src/dta/scripts/sync-kkphim-movie.ts",
    "sync:ophim:movie": "npx tsx --require dotenv/config src/dta/scripts/sync-ophim-movie.ts",
    "sync:ophim18:movie": "npx tsx --require dotenv/config src/dta/scripts/sync-ophim18-movie.ts",
    "sync:ophim18:catalog": "npx tsx --require dotenv/config src/dta/scripts/sync-ophim18-catalog.ts",
    "enrich:tmdb": "npx tsx --require dotenv/config src/dta/scripts/enrich-tmdb.ts",
    "pipeline:movie": "npx tsx --require dotenv/config src/dta/scripts/pipeline-movie.ts",
    "search:reindex": "npx tsx --require dotenv/config src/dta/scripts/elastic-reindex.ts",
    "search:clear": "npx tsx --require dotenv/config src/dta/scripts/elastic-reindex.ts -- --clear",
    "search:test": "node scripts/test-search.mjs",
    "search:test:tiers": "npx tsx --require dotenv/config src/dta/scripts/elastic-test-queries.ts",
    "search:sync-subtitles": "npx tsx --require dotenv/config src/dta/scripts/sync-subtitles.ts",
    "search:sync-cast": "npx tsx --require dotenv/config src/dta/scripts/sync-cast-from-tmdb.ts",
    "search:enrich-real": "npx tsx --require dotenv/config src/dta/scripts/enrich-real-movies.ts",
    "shorts:sync": "npx tsx --require dotenv/config src/dta/scripts/sync-shorts.ts",
    "demo:pay": "npx tsx --require dotenv/config scripts/simulate-bank-transfer.ts",
    "seed:ads": "npx tsx --require dotenv/config src/dta/scripts/seed-ads.ts",
    "seed:demo-users": "npx tsx --require dotenv/config scripts/seed-mock-users.ts",
    "seed:demo-content": "npx tsx --require dotenv/config scripts/seed-mock-content.ts",
    "seed:demo-dashboard": "npx tsx --require dotenv/config src/dta/scripts/seed-dashboard-demo.ts",
    "cleanup:demo-data": "npx tsx --require dotenv/config scripts/cleanup-mock-data.ts",
    "user:role": "npx tsx --require dotenv/config scripts/set-user-role.ts",
    "livekit:check": "npx tsx --require dotenv/config scripts/check-livekit.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:rebuild": "docker compose build --no-cache app",
    "docker:logs": "docker compose logs -f app",
    "docker:reindex": "docker compose exec app npm run search:reindex",
    "docs:check": "node src/dta/scripts/docs-check.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:docker": "docker compose -f docker-compose.test.yml up --build --abort-on-container-exit",
    "prepare": "husky"
  },
  "prisma": {
    "seed": "npx tsx --require dotenv/config src/dta/prisma/seed.ts",
    "schema": "src/dta/prisma/schema.prisma"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@elastic/elasticsearch": "^8.14.0",
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4",
    "@prisma/client": "^6.19.2",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@vercel/analytics": "1.6.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dataloader": "^2.2.3",
    "dotenv": "^17.4.1",
    "hls.js": "^1.6.15",
    "ioredis": "^5.10.1",
    "livekit-client": "^2.18.0",
    "livekit-server-sdk": "^2.15.0",
    "lucide-react": "^0.564.0",
    "next": "16.1.6",
    "next-auth": "^4.24.13",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.13",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-quill-new": "^3.8.3",
    "recharts": "2.15.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^1.7.1",
    "swr": "^2.3.3",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.6",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitest/coverage-v8": "^4.1.3",
    "docx": "^9.6.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.21.0",
    "tw-animate-css": "1.3.3",
    "typescript": "5.7.3",
    "vitest": "^4.1.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.2": true,
    "@prisma/engines@6.19.2": true,
    "bcrypt@6.0.0": true,
    "esbuild@0.27.4": true,
    "prisma@6.19.2": true,
    "sharp@0.34.5": true
  }
}
